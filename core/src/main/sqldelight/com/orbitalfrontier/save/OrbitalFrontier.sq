-- Orbital Frontier save schema, version 18 (ADR 0002 / ADR 0003 / ADR 0008 / ADR 0010 / ADR 0011 / ADR 0012 / ADR 0013 / ADR 0014 / ADR 0020 / ADR 0024 / ADR 0025 / ADR 0026).
--
-- This .sq file is ALWAYS the latest schema (currently v18). Earlier versions are upgraded to it
-- by the sequential `.sqm` migration files in migrations/ (1.sqm: v1 -> v2; 2.sqm: v2 -> v3; …;
-- 14.sqm: v14 -> v15; 15.sqm: v15 -> v16; 16.sqm: v16 -> v17; 17.sqm: v17 -> v18). Never edit this
-- baseline destructively to make a schema change — bump the version and add a migration instead.
--
-- v1..v16 history is preserved in the migration files. Briefly: v1 (UC01) meta + settings; v2..v6
-- (UC04..UC08) the single-slot autosave header (`game_state`) + ship kinematics + dock + cargo +
-- field depletion + fuel + credits; v7 (UC09) the fleet (`ship.ship_type` + `ship_upgrade`); v8 (UC10)
-- `revealed_contact`; v9 (UC11) `ship.crew`; v10 (UC12) `mission`; v11 (UC13) `ship_section_damage` +
-- `game_state.last_docked_station_id`; v12 (UC14) `reputation` + `mission.faction_id`; v13 (UC15)
-- `owned_station` + `station_module`; v14 (UC31) audio settings; v15 (UC36) `settings.tutorial_completed`;
-- v16 (UC37) `settings.joystick_*` + `settings.ui_scale`.
--
-- v17 (UC38, ADR 0026) adds **save-slot management**. Where v1..v16 held a SINGLE autosave (the
-- `game_state` row was single-row, CHECK (id = 0), and every game-state table was implicitly that one
-- save's), v17 **partitions every game-state table by `slot_id`** (Option A — one DB, a slot partition
-- column — chosen over multiple DB files; see ADR 0026). A fixed, small range of slot indices
-- (`0 until SaveSlots.COUNT`) each holds an independent save; `meta.active_slot_id` records which slot
-- the autosave currently targets and `Continue` resumes (UC38 AC#3). Slot 0 is the **legacy** slot:
-- the v16 -> v17 migration rebuilds each game-state table to add `slot_id` to its primary key and
-- backfills the pre-UC38 save into slot 0 (UC38 AC#3), so an upgraded single-autosave save reads back
-- intact as slot 0 named "Autosave". The `game_state` header also gains the slot's display metadata —
-- `name`, `last_saved_epoch_millis`, `play_time_seconds` (UC38 AC#1). `settings` is UNCHANGED by v17 (control
-- preferences are global, not per-slot).
--
-- v18 (UC39) adds the **accessibility preferences** to the global `settings` row — `colorblind_mode`
-- (palette mode), `text_scale` (UI text-size multiplier on top of the UI scale) and `reduced_motion`
-- (the parallax/animation toggle). Like every other settings column they are global (not per-slot) and
-- each has its own targeted UPDATE. See the `settings` table comment below.
--
-- Slot isolation (UC38 AC#4): every read/write/delete is scoped by `slot_id`, so loading, saving or
-- deleting one slot never reads or mutates another. `meta`/`settings` rows are single-row (CHECK (id = 0)).

CREATE TABLE meta (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    save_version INTEGER NOT NULL,
    -- v17 (UC38): the slot the autosave writes to and Continue resumes (UC38 AC#3). DEFAULT 0 so the
    -- v16 -> v17 migration backfills the legacy save's pointer to the legacy slot (slot 0). Single-row.
    active_slot_id INTEGER NOT NULL DEFAULT 0
);

-- v14 (UC31, ADR 0020) adds the audio preferences; v15 (UC36, ADR 0024) the first-run tutorial flag;
-- v16 (UC37, ADR 0025) the joystick tuning + the UI scale; v18 (UC39) the accessibility preferences
-- (colourblind palette mode, UI text scale, reduced motion). Each is its own column with its own targeted
-- UPDATE so persisting one preference never clobbers another. UNCHANGED by v17 — settings are global
-- (shared across all save slots), not per-slot.
CREATE TABLE settings (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    handedness TEXT NOT NULL,
    master_muted INTEGER NOT NULL DEFAULT 0,
    sfx_volume REAL NOT NULL DEFAULT 1.0,
    music_volume REAL NOT NULL DEFAULT 0.5,
    tutorial_completed INTEGER NOT NULL DEFAULT 0,
    joystick_sensitivity REAL NOT NULL DEFAULT 1.0,
    joystick_deadzone REAL NOT NULL DEFAULT 0.15,
    ui_scale REAL NOT NULL DEFAULT 2.0,
    -- v18 (UC39) accessibility: colourblind palette mode (ColorVisionMode NAME; unknown -> STANDARD on
    -- load), UI text-size multiplier applied on top of ui_scale (DEFAULT 1.0 = no extra magnification),
    -- and the reduced-motion toggle (0 = motion on, the prior full-parallax behaviour).
    colorblind_mode TEXT NOT NULL DEFAULT 'STANDARD',
    text_scale REAL NOT NULL DEFAULT 1.0,
    reduced_motion INTEGER NOT NULL DEFAULT 0
);

-- Per-slot save "header" (v17, UC38): one row per OCCUPIED slot (an empty slot simply has no row). The
-- primary key is `slot_id` (was the single-row CHECK (id = 0) before v17). Holds the gameplay singletons
-- — which sector the player is in, which owned ship is active, the current/last dock, the credit balance —
-- plus the v17 slot display metadata (UC38 AC#1): the player-facing `name`, the wall-clock
-- `last_saved_epoch_millis` (0 = unknown, rendered "—"), and accumulated `play_time_seconds`.
-- `docked_station_id` / `last_docked_station_id` are NULLABLE PoiIds (NULL in flight / never docked).
-- `credits` DEFAULT 0; the repository coerces a negative/corrupt value to >= 0.
-- `name` DEFAULT '' is set on slot creation (new-game-into-slot / the legacy backfill "Autosave"); an
-- autosave UPDATEs only the gameplay columns and never `name`, so autosave can never overwrite the
-- player's chosen name (the name-clobber guard, UC38). Renaming uses the targeted `setSlotName`.
CREATE TABLE game_state (
    slot_id INTEGER NOT NULL PRIMARY KEY,
    current_sector TEXT NOT NULL,
    active_ship_id INTEGER NOT NULL,
    docked_station_id TEXT,
    credits INTEGER NOT NULL DEFAULT 0,
    last_docked_station_id TEXT,
    name TEXT NOT NULL DEFAULT '',
    last_saved_epoch_millis INTEGER NOT NULL DEFAULT 0,
    play_time_seconds INTEGER NOT NULL DEFAULT 0
);

-- Owned-ship kinematics + per-ship stats source (UC09; v17 adds `slot_id` to the PK). One row per owned
-- ship within a slot; `game_state.active_ship_id` selects the active one. Ship ids are per-save (Fleet
-- allocates max+1), so they collide across slots — hence the composite (slot_id, id) primary key. Stored
-- as REAL (SQLite has no Float); the repository owns the single Float<->Double conversion (UC04 AC#8).
-- `fuel` (UC07) capacity is NOT stored (derived). `ship_type` (UC09) DEFAULT 'starter'; an unknown slug
-- degrades to the starter on load. `crew` (UC11) DEFAULT 0; capacity is derived.
CREATE TABLE ship (
    slot_id INTEGER NOT NULL,
    id INTEGER NOT NULL,
    pos_x REAL NOT NULL,
    pos_y REAL NOT NULL,
    vel_x REAL NOT NULL,
    vel_y REAL NOT NULL,
    heading REAL NOT NULL,
    ang_vel REAL NOT NULL,
    fuel REAL NOT NULL DEFAULT 100,
    ship_type TEXT NOT NULL DEFAULT 'starter',
    crew INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (slot_id, id)
);

-- Per-ship installed upgrades (UC09; v17 adds `slot_id` to the PK). One row per filled (slot, ship,
-- category, index). A ship's rows are rewritten as a full snapshot (delete-then-insert) on each save.
CREATE TABLE ship_upgrade (
    slot_id INTEGER NOT NULL,
    ship_id INTEGER NOT NULL,
    slot_category TEXT NOT NULL,
    slot_index INTEGER NOT NULL,
    upgrade_id TEXT NOT NULL,
    PRIMARY KEY (slot_id, ship_id, slot_category, slot_index)
);

-- Per-ship cargo (UC06; v17 adds `slot_id` to the PK). One row per (slot, ship, resource) with a
-- non-zero amount; capacity is derived, not stored. Full-snapshot rewrite per ship (delete-then-insert).
CREATE TABLE cargo (
    slot_id INTEGER NOT NULL,
    ship_id INTEGER NOT NULL,
    resource TEXT NOT NULL,
    units INTEGER NOT NULL,
    PRIMARY KEY (slot_id, ship_id, resource)
);

-- Per-ship combat section damage (UC13; v17 adds `slot_id` to the PK). One row per (slot, ship, section)
-- the ship has taken damage on, storing current HP. An absent section is pristine; max HP is derived.
-- Full-snapshot rewrite per ship (delete-then-insert), like cargo.
CREATE TABLE ship_section_damage (
    slot_id INTEGER NOT NULL,
    ship_id INTEGER NOT NULL,
    section TEXT NOT NULL,
    current_hp INTEGER NOT NULL,
    PRIMARY KEY (slot_id, ship_id, section)
);

-- Asteroid-field depletion (UC06; v17 adds `slot_id` to the PK). One row per (slot, field, resource)
-- with the REMAINING units. An absent field is pristine. Depletion is monotonic, so saves upsert and
-- never delete.
CREATE TABLE field_deposit (
    slot_id INTEGER NOT NULL,
    field_id TEXT NOT NULL,
    resource TEXT NOT NULL,
    remaining_units INTEGER NOT NULL,
    PRIMARY KEY (slot_id, field_id, resource)
);

-- Revealed hidden contacts (UC10; v17 adds `slot_id` to the PK). One row per (slot, contact) the player
-- has uncovered. Reveal is monotonic (INSERT OR IGNORE, never deleted), per slot.
CREATE TABLE revealed_contact (
    slot_id INTEGER NOT NULL,
    contact_id TEXT NOT NULL,
    PRIMARY KEY (slot_id, contact_id)
);

-- Accepted / terminal missions (UC12; v17 adds `slot_id` to the PK). One row per (slot, mission). AVAILABLE
-- offers are NOT stored — regenerated-and-filtered on load (ADR 0011). Enum/resource columns store the enum
-- NAMEs (stable across reordering). Unknown enum/resource/faction degrades on load (skip with a WARN).
CREATE TABLE mission (
    slot_id INTEGER NOT NULL,
    id TEXT NOT NULL,
    type TEXT NOT NULL,
    source TEXT NOT NULL,
    status TEXT NOT NULL,
    reward_credits INTEGER NOT NULL,
    reward_resource TEXT,
    reward_resource_units INTEGER NOT NULL DEFAULT 0,
    quota_resource TEXT,
    quota_units INTEGER NOT NULL DEFAULT 0,
    pickup TEXT,
    destination TEXT,
    remaining_ticks INTEGER NOT NULL DEFAULT 0,
    picked_up INTEGER NOT NULL DEFAULT 0,
    faction_id TEXT,
    PRIMARY KEY (slot_id, id)
);

-- Player per-faction reputation (UC14; v17 adds `slot_id` to the PK). One row per (slot, faction) with a
-- NON-NEUTRAL standing; an absent faction is neutral (0). Full-snapshot rewrite per slot.
CREATE TABLE reputation (
    slot_id INTEGER NOT NULL,
    faction_id TEXT NOT NULL,
    value INTEGER NOT NULL,
    PRIMARY KEY (slot_id, faction_id)
);

-- Player-owned stations (UC15; v17 adds `slot_id` to the PK). One row per (slot, station). Station ids are
-- per-save (allocated max+1), so they collide across slots — hence the composite (slot_id, id) PK.
CREATE TABLE owned_station (
    slot_id INTEGER NOT NULL,
    id INTEGER NOT NULL,
    sector TEXT NOT NULL,
    PRIMARY KEY (slot_id, id)
);

-- Per-station built modules (UC15; v17 adds `slot_id` to the PK). One row per (slot, station, slot_index).
-- Gaps allowed. Full-snapshot rewrite per station (delete-then-insert).
CREATE TABLE station_module (
    slot_id INTEGER NOT NULL,
    station_id INTEGER NOT NULL,
    slot_index INTEGER NOT NULL,
    module_type TEXT NOT NULL,
    PRIMARY KEY (slot_id, station_id, slot_index)
);

-- ============================================================================================
-- meta / active-slot pointer (UC38)
-- ============================================================================================

-- Read the stored save-format version (null before the meta row is seeded).
selectSaveVersion:
SELECT save_version FROM meta WHERE id = 0;

-- Seed the meta row once; idempotent (no-op if the row already exists). `active_slot_id` defaults to 0.
initMeta:
INSERT OR IGNORE INTO meta(id, save_version) VALUES (0, ?);

-- Read which slot the autosave targets / Continue resumes (UC38 AC#3). Defaults to 0 (the legacy slot).
selectActiveSlot:
SELECT active_slot_id FROM meta WHERE id = 0;

-- Point the autosave / Continue at a slot (UC38): set on new-game-into-slot and load-slot. Targeted
-- single-column UPDATE; relies on the meta row already existing (initMeta runs first).
setActiveSlot:
UPDATE meta SET active_slot_id = ? WHERE id = 0;

-- ============================================================================================
-- settings (global — unchanged by v17)
-- ============================================================================================

selectSettings:
SELECT handedness, master_muted, sfx_volume, music_volume, tutorial_completed,
       joystick_sensitivity, joystick_deadzone, ui_scale,
       colorblind_mode, text_scale, reduced_motion
FROM settings WHERE id = 0;

seedSettings:
INSERT OR IGNORE INTO settings(id, handedness, master_muted, sfx_volume, music_volume) VALUES (0, ?, ?, ?, ?);

updateHandedness:
UPDATE settings SET handedness = ? WHERE id = 0;

updateAudioSettings:
UPDATE settings SET master_muted = ?, sfx_volume = ?, music_volume = ? WHERE id = 0;

updateTutorialCompleted:
UPDATE settings SET tutorial_completed = ? WHERE id = 0;

updateJoystickTuning:
UPDATE settings SET joystick_sensitivity = ?, joystick_deadzone = ? WHERE id = 0;

updateUiScale:
UPDATE settings SET ui_scale = ? WHERE id = 0;

updateColorblindMode:
UPDATE settings SET colorblind_mode = ? WHERE id = 0;

updateTextScale:
UPDATE settings SET text_scale = ? WHERE id = 0;

updateReducedMotion:
UPDATE settings SET reduced_motion = ? WHERE id = 0;

-- ============================================================================================
-- game_state header — per slot (UC38)
-- ============================================================================================

-- Read one slot's save header (UC38). Returns no rows when the slot is empty (-> Empty slot / New Game).
selectGameStateForSlot:
SELECT current_sector, active_ship_id, docked_station_id, credits, last_docked_station_id,
       name, last_saved_epoch_millis, play_time_seconds
FROM game_state
WHERE slot_id = ?;

-- True once a save header exists for the slot (the slot is occupied). False on an empty slot.
hasSlot:
SELECT EXISTS(SELECT 1 FROM game_state WHERE slot_id = ?);

-- List every OCCUPIED slot's display row in one query (UC38 AC#1) — slot id, name, last-saved time,
-- play time, credits and current sector — WITHOUT loading any ship/cargo/etc. The repository fills the
-- empty indices (a slot with no row) in with `SaveSlotSummary.Empty`. Ordered by slot id for a stable list.
listSlots:
SELECT slot_id, name, last_saved_epoch_millis, play_time_seconds, credits, current_sector
FROM game_state
ORDER BY slot_id;

-- Create a slot's header row once, only if absent (UC38). Seeds the player-facing `name` and the two
-- gameplay columns that have no DEFAULT (current_sector, active_ship_id); the rest take their column
-- DEFAULTs and are then set by `updateSlotHeader` in the same transaction. INSERT OR IGNORE (not UPSERT)
-- for the minSdk-24 rationale shared by every other write here — so re-seeding an existing slot is a
-- no-op and NEVER clobbers the player's chosen name.
insertSlotHeaderIfAbsent:
INSERT OR IGNORE INTO game_state(slot_id, current_sector, active_ship_id, name) VALUES (?, ?, ?, ?);

-- Update ONLY a slot's gameplay columns + the autosave metadata (last-saved time, play time) — never
-- `name`. The name-clobber guard (UC38): autosave runs this, so it can never overwrite the player's
-- chosen slot name. Relies on the row already existing (insertSlotHeaderIfAbsent runs first).
updateSlotHeader:
UPDATE game_state SET current_sector = ?, active_ship_id = ?, docked_station_id = ?, credits = ?,
       last_docked_station_id = ?, last_saved_epoch_millis = ?, play_time_seconds = ?
WHERE slot_id = ?;

-- Targeted slot-rename (UC38 AC#2): sets ONLY the `name` column, so renaming never touches gameplay.
-- Used by new-game-into-slot (to set the initial player-facing name) and manual save-as / rename.
setSlotName:
UPDATE game_state SET name = ? WHERE slot_id = ?;

-- ============================================================================================
-- ship — per slot
-- ============================================================================================

selectShipsForSlot:
SELECT id, pos_x, pos_y, vel_x, vel_y, heading, ang_vel, fuel, ship_type, crew
FROM ship WHERE slot_id = ? ORDER BY id;

upsertShip:
INSERT OR REPLACE INTO ship(slot_id, id, pos_x, pos_y, vel_x, vel_y, heading, ang_vel, fuel, ship_type, crew)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- ============================================================================================
-- ship_upgrade — per slot
-- ============================================================================================

selectAllShipUpgradesForSlot:
SELECT ship_id, slot_category, slot_index, upgrade_id FROM ship_upgrade
WHERE slot_id = ? ORDER BY ship_id, slot_category, slot_index;

deleteShipUpgradesForShip:
DELETE FROM ship_upgrade WHERE slot_id = ? AND ship_id = ?;

insertShipUpgrade:
INSERT INTO ship_upgrade(slot_id, ship_id, slot_category, slot_index, upgrade_id) VALUES (?, ?, ?, ?, ?);

-- ============================================================================================
-- cargo — per slot
-- ============================================================================================

selectAllCargoForSlot:
SELECT ship_id, resource, units FROM cargo WHERE slot_id = ? ORDER BY ship_id, resource;

deleteCargoForShip:
DELETE FROM cargo WHERE slot_id = ? AND ship_id = ?;

insertCargoEntry:
INSERT INTO cargo(slot_id, ship_id, resource, units) VALUES (?, ?, ?, ?);

-- ============================================================================================
-- ship_section_damage — per slot
-- ============================================================================================

selectAllShipSectionDamageForSlot:
SELECT ship_id, section, current_hp FROM ship_section_damage WHERE slot_id = ? ORDER BY ship_id, section;

deleteShipSectionDamageForShip:
DELETE FROM ship_section_damage WHERE slot_id = ? AND ship_id = ?;

insertShipSectionDamage:
INSERT INTO ship_section_damage(slot_id, ship_id, section, current_hp) VALUES (?, ?, ?, ?);

-- ============================================================================================
-- field_deposit — per slot
-- ============================================================================================

selectFieldDepositsForSlot:
SELECT field_id, resource, remaining_units FROM field_deposit WHERE slot_id = ?;

upsertFieldDeposit:
INSERT OR REPLACE INTO field_deposit(slot_id, field_id, resource, remaining_units) VALUES (?, ?, ?, ?);

-- ============================================================================================
-- revealed_contact — per slot
-- ============================================================================================

selectRevealedContactsForSlot:
SELECT contact_id FROM revealed_contact WHERE slot_id = ?;

insertRevealedContact:
INSERT OR IGNORE INTO revealed_contact(slot_id, contact_id) VALUES (?, ?);

-- ============================================================================================
-- mission — per slot
-- ============================================================================================

selectAllMissionsForSlot:
SELECT id, type, source, status, reward_credits, reward_resource, reward_resource_units,
       quota_resource, quota_units, pickup, destination, remaining_ticks, picked_up, faction_id
FROM mission
WHERE slot_id = ?
ORDER BY id;

deleteAllMissionsForSlot:
DELETE FROM mission WHERE slot_id = ?;

insertMission:
INSERT INTO mission(slot_id, id, type, source, status, reward_credits, reward_resource, reward_resource_units,
                    quota_resource, quota_units, pickup, destination, remaining_ticks, picked_up, faction_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- ============================================================================================
-- reputation — per slot
-- ============================================================================================

selectReputationForSlot:
SELECT faction_id, value FROM reputation WHERE slot_id = ?;

deleteAllReputationForSlot:
DELETE FROM reputation WHERE slot_id = ?;

insertReputation:
INSERT INTO reputation(slot_id, faction_id, value) VALUES (?, ?, ?);

-- ============================================================================================
-- owned_station — per slot
-- ============================================================================================

selectAllOwnedStationsForSlot:
SELECT id, sector FROM owned_station WHERE slot_id = ? ORDER BY id;

upsertOwnedStation:
INSERT OR REPLACE INTO owned_station(slot_id, id, sector) VALUES (?, ?, ?);

-- ============================================================================================
-- station_module — per slot
-- ============================================================================================

selectAllStationModulesForSlot:
SELECT station_id, slot_index, module_type FROM station_module WHERE slot_id = ? ORDER BY station_id, slot_index;

deleteStationModulesForStation:
DELETE FROM station_module WHERE slot_id = ? AND station_id = ?;

insertStationModule:
INSERT INTO station_module(slot_id, station_id, slot_index, module_type) VALUES (?, ?, ?, ?);

-- ============================================================================================
-- Per-slot wipe (UC38): clear ONE slot's durable game-state rows (used by clearSave(slot) — Start a fresh
-- game over a slot — and deleteSlot(slot) — remove a slot, UC38 AC#2). Covers every non-meta / non-settings
-- table for the given slot, leaving `meta` (version + active-slot pointer) and `settings` (global prefs)
-- intact and, crucially, leaving EVERY OTHER SLOT untouched (slot isolation, UC38 AC#4). The repository runs
-- all of these in ONE transaction so a wipe is atomic.
-- ============================================================================================

deleteGameStateForSlot:
DELETE FROM game_state WHERE slot_id = ?;

deleteShipsForSlot:
DELETE FROM ship WHERE slot_id = ?;

deleteAllShipUpgradesForSlot:
DELETE FROM ship_upgrade WHERE slot_id = ?;

deleteAllCargoForSlot:
DELETE FROM cargo WHERE slot_id = ?;

deleteAllShipSectionDamageForSlot:
DELETE FROM ship_section_damage WHERE slot_id = ?;

deleteAllFieldDepositsForSlot:
DELETE FROM field_deposit WHERE slot_id = ?;

deleteAllRevealedContactsForSlot:
DELETE FROM revealed_contact WHERE slot_id = ?;

deleteAllOwnedStationsForSlot:
DELETE FROM owned_station WHERE slot_id = ?;

deleteAllStationModulesForSlot:
DELETE FROM station_module WHERE slot_id = ?;
