-- Orbital Frontier save schema, version 12 (ADR 0002 / ADR 0003 / ADR 0008 / ADR 0010 / ADR 0011 / ADR 0012 / ADR 0013).
--
-- This .sq file is ALWAYS the latest schema (currently v12). Earlier versions are upgraded to it
-- by the sequential `.sqm` migration files in migrations/ (1.sqm: v1 -> v2; 2.sqm: v2 -> v3;
-- 3.sqm: v3 -> v4; 4.sqm: v4 -> v5; 5.sqm: v5 -> v6; 6.sqm: v6 -> v7; 7.sqm: v7 -> v8; 8.sqm:
-- v8 -> v9; 9.sqm: v9 -> v10; 10.sqm: v10 -> v11; 11.sqm: v11 -> v12). Never edit this baseline
-- destructively to make a schema change — bump the version and add a migration instead.
--
-- v1 (UC01) held only `meta` (save-format version) and `settings` (handedness). v2 (UC04) adds
-- the first slice of actual game state — the single autosave "header" (`game_state`) plus the
-- player's ship kinematics (`ship`). v3 (UC05) adds the player's dock state to the header
-- (`game_state.docked_station_id`). v4 (UC06) adds the player's `cargo` (per-ship resource units)
-- and asteroid-field `field_deposit` (remaining units per field). v5 (UC07) adds the active ship's
-- `ship.fuel` level. v6 (UC08) adds the player's `game_state.credits` wallet (save-wide single
-- currency).
-- v7 (UC09) generalizes the single ship into a **fleet**: `ship` gains a `ship_type` column (the
-- ShipTypeId slug, DEFAULT 'starter' matching ShipRoster.STARTER_TYPE_ID) and there is a new
-- `ship_upgrade` table holding each ship's installed upgrades per (slot_category, slot_index). The
-- player can now own multiple ships (multiple `ship` rows, each with its own cargo + upgrades);
-- `game_state.active_ship_id` selects the active one. The v6 -> v7 migration is additive: it adds the
-- column (backfilled to 'starter') and the table (empty) so a migrated save reads back as one starter
-- ship with no upgrades. Station markets / outfit markets / upgrade & ship catalogs are NOT persisted
-- — they are fixed authored data reconstructed from MvpSectorMap / UpgradeCatalog / ShipRoster on load
-- (ADR 0007 / ADR 0008). Cargo & fuel *capacities* are derived ship stats reconstructed from
-- type + loadout on load (ShipStats), never stored. Box2D internals are never persisted — only the
-- pure kinematics the model re-seeds the body from on load (UC04 pitfall).
-- v8 (UC10) adds the new `revealed_contact` table: the ids of no-transponder hidden contacts the
-- player has uncovered by active scanning (UC10 AC#4). Reveal is **monotonic** — a row is only ever
-- inserted (INSERT OR IGNORE), never deleted, so a revealed contact stays known across save/reload.
-- The v7 -> v8 migration is additive: it creates the (empty) table, so a migrated save reads back with
-- nothing revealed. Hidden contacts themselves are fixed authored map data (MvpSectorMap), not stored.
-- v9 (UC11) adds the per-ship `ship.crew` column: the crew COUNT aboard each owned ship (ADR 0010).
-- Crew is hired at a crew-hiring station for credits up to the ship's crew CAPACITY (a derived stat
-- from type + loadout, NOT stored — like cargo/fuel capacity). The v8 -> v9 migration is additive: it
-- adds the column with DEFAULT 0, so a migrated ship reads back with 0 crew. Turret operability is a
-- pure derived flag (TurretOperability), not persisted; combat (UC13) is future work.
-- v10 (UC12) adds the new `mission` table: the player's accepted / terminal missions — ACTIVE,
-- COMPLETED and FAILED (ADR 0011). AVAILABLE offers are deliberately NOT stored: they are regenerated
-- from the static authored world on load (MissionGenerator) and filtered against the persisted ids, so
-- an accepted or resolved offer never re-appears (regenerate-and-filter). The v9 -> v10 migration is
-- additive: it creates the (empty) table, so a migrated save reads back with no missions. Mission
-- templates / generation are fixed authored logic, not stored — only live mission instances are rows.
-- v11 (UC13) adds the player's durable **combat** state: the new `ship_section_damage` table (per-ship
-- current HP for each damaged section — full-snapshot per ship like `cargo`; an absent section is
-- pristine, max HP is the derived ShipStats stat and is NOT stored) and `game_state.last_docked_station_id`
-- (the respawn point on destruction, UC13 AC#5). Transient combat (hostiles, projectiles, combat RNG) is
-- NOT persisted — it is regenerated from the seeded encounter on load (a mid-combat save reloads with
-- combat cleared, ADR 0012). The v10 -> v11 migration is additive (new table + new NULLABLE column).
-- v12 (UC14) adds **factions & reputation** (ADR 0013): the new `reputation` table (one row per faction
-- the player holds a NON-NEUTRAL standing with — neutral 0 is the absent-row default, like cargo only
-- storing non-zero amounts) and a nullable `mission.faction_id` column (the faction a persisted mission
-- credits reputation to on completion / costs it on courier expiry). Factions themselves are fixed
-- authored data (Factions catalog), not stored — only the player's per-faction standing and a mission's
-- faction attribution are rows. The mission **gate** (unlockFaction/unlockThreshold) is NOT stored: it
-- only affects which AVAILABLE offers surface, and AVAILABLE offers are never persisted (regenerated +
-- gate-filtered on load, ADR 0011/0013). The v11 -> v12 migration is additive (new table + new NULLABLE
-- column). An unknown faction slug degrades gracefully on load (skip the reputation row / drop the
-- attribution with a WARN — never stranded).
--
-- The `meta`/`settings` rows are single-row (CHECK (id = 0)); `game_state` is likewise single-row.

CREATE TABLE meta (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    save_version INTEGER NOT NULL
);

CREATE TABLE settings (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    handedness TEXT NOT NULL
);

-- Single-row save "header": which sector the player is in, which owned ship is active, which
-- station (if any) the active ship is docked at, and the player's credit balance. Future save-wide
-- singletons (current mission, …) land here additively as later UCs arrive.
-- `docked_station_id` is NULLABLE: NULL means the active ship is in flight (the common case); a
-- non-null value is the [PoiId] of the docked station (UC05 AC#4).
-- `credits` (UC08) is the player's single-currency wallet, save-wide (not per-ship). DEFAULT 0
-- matches the v5 -> v6 migration's backfill; the repository coerces a negative/corrupt value to >= 0.
-- `last_docked_station_id` (UC13) is the player's most-recent dock — the respawn point on destruction
-- (AC#5). NULLABLE: NULL means "never docked yet" (a fresh game / a migrated v10 save), so on respawn the
-- model leaves the player in place. Distinct from `docked_station_id` (the CURRENT dock, null in flight):
-- this one is set on each dock and retained after undocking.
CREATE TABLE game_state (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    current_sector TEXT NOT NULL,
    active_ship_id INTEGER NOT NULL,
    docked_station_id TEXT,
    credits INTEGER NOT NULL DEFAULT 0,
    last_docked_station_id TEXT
);

-- Owned-ship kinematics + per-ship stats source (UC09: one row per owned ship; `active_ship_id`
-- selects the active one). Stored as REAL (SQLite has no Float); the repository owns the single
-- Float<->Double conversion so a round-trip is exact (UC04 AC#8).
-- `fuel` (UC07) is the ship's fuel level in fuel units; capacity is NOT stored — it is a derived
-- ship stat (ShipStats.fuelCapacity(type, loadout)) reconstructed on load.
-- `ship_type` (UC09) is the ShipTypeId slug (ShipRoster). DEFAULT 'starter' matches the v6 -> v7
-- migration's backfill so a migrated ship reads back as the starter type. An unknown slug degrades
-- to the starter type with a WARN on load (never stranded).
-- `crew` (UC11) is the crew COUNT aboard this ship. DEFAULT 0 matches the v8 -> v9 migration's
-- backfill so a migrated ship reads back uncrewed. Crew CAPACITY is NOT stored — it is a derived ship
-- stat (ShipStats.crewCapacity(type, loadout)); the repository coerces a corrupt/over-capacity value
-- into 0..capacity on load.
CREATE TABLE ship (
    id INTEGER NOT NULL PRIMARY KEY,
    pos_x REAL NOT NULL,
    pos_y REAL NOT NULL,
    vel_x REAL NOT NULL,
    vel_y REAL NOT NULL,
    heading REAL NOT NULL,
    ang_vel REAL NOT NULL,
    fuel REAL NOT NULL DEFAULT 100,
    ship_type TEXT NOT NULL DEFAULT 'starter',
    crew INTEGER NOT NULL DEFAULT 0
);

-- Per-ship installed upgrades (UC09). One row per filled (ship, slot): `slot_category` is the
-- SlotCategory enum *name*, `slot_index` the slot position within that category (gaps are allowed —
-- an absent (category, index) is an empty slot), `upgrade_id` the UpgradeId slug (resolved against
-- UpgradeCatalog on load; an unknown id is skipped with a WARN). Keyed by (ship_id, slot_category,
-- slot_index). A ship's rows are rewritten as a full snapshot (delete-then-insert) on each save.
CREATE TABLE ship_upgrade (
    ship_id INTEGER NOT NULL,
    slot_category TEXT NOT NULL,
    slot_index INTEGER NOT NULL,
    upgrade_id TEXT NOT NULL,
    PRIMARY KEY (ship_id, slot_category, slot_index)
);

-- Per-ship cargo (UC06). One row per (ship, resource) the ship is carrying a non-zero amount of;
-- `resource` is the ResourceType enum *name* (stable across enum reordering, unlike its ordinal).
-- Keyed by (ship_id, resource). Capacity is NOT stored — it is a derived ship stat reconstructed from
-- type + loadout on load. Each ship's rows are rewritten as a full snapshot (delete-then-insert).
CREATE TABLE cargo (
    ship_id INTEGER NOT NULL,
    resource TEXT NOT NULL,
    units INTEGER NOT NULL,
    PRIMARY KEY (ship_id, resource)
);

-- Per-ship combat section damage (UC13). One row per (ship, section) the ship has taken damage on,
-- storing the section's *current* HP; `section` is the ShipSection enum *name* (stable across reordering,
-- unlike the ordinal). A section with NO row here is pristine (full derived max HP); max HP is a derived
-- ship stat (ShipStats.sectionHp from type + loadout) and is NOT stored. Keyed by (ship_id, section). Each
-- ship's rows are rewritten as a full snapshot (delete-then-insert), exactly like cargo. Transient combat
-- (hostiles/projectiles/RNG) is never persisted — only this durable per-ship damage is (ADR 0012).
CREATE TABLE ship_section_damage (
    ship_id INTEGER NOT NULL,
    section TEXT NOT NULL,
    current_hp INTEGER NOT NULL,
    PRIMARY KEY (ship_id, section)
);

-- Asteroid-field depletion (UC06). One row per (field, resource) the field has been mined from,
-- storing the *remaining* units. `field_id` is the field's PoiId value (globally unique across the
-- sector graph — see SectorWorld.allPoiIds), `resource` the ResourceType enum name. A field with NO
-- rows here is pristine (its authored deposits apply). Depletion is monotonic (units only ever
-- decrease), so saves upsert the latest snapshot per (field, resource) and never delete.
CREATE TABLE field_deposit (
    field_id TEXT NOT NULL,
    resource TEXT NOT NULL,
    remaining_units INTEGER NOT NULL,
    PRIMARY KEY (field_id, resource)
);

-- Revealed hidden contacts (UC10). One row per [HiddenContact] the player has uncovered by active
-- scanning; `contact_id` is the contact's PoiId value (globally unique across the sector graph). A
-- contact with NO row here is still hidden. Reveal is monotonic (a contact never re-hides), so saves
-- only ever INSERT OR IGNORE these ids and never delete. A row for a contact the authored map no
-- longer contains is harmless (it resolves to nothing on load).
CREATE TABLE revealed_contact (
    contact_id TEXT NOT NULL PRIMARY KEY
);

-- Accepted / terminal missions (UC12). One row per ACTIVE / COMPLETED / FAILED mission, keyed by the
-- mission's stable id. AVAILABLE offers are NOT stored here — they are regenerated from the static
-- authored world on load (MissionGenerator) and filtered against these ids, so an accepted or resolved
-- offer never re-appears (regenerate-and-filter, ADR 0011). `type`/`source`/`status` are the
-- MissionType/MissionSource/MissionStatus enum *names* (stable across reordering, unlike ordinals);
-- `reward_resource`/`quota_resource` are ResourceType enum names (nullable). The courier columns
-- (`pickup`/`destination` PoiId values, `remaining_ticks` model timer, `picked_up` 0/1) are NULL/0 for
-- a mining mission and vice-versa. An unknown enum / resource / station name degrades on load (the row
-- is skipped with a WARN — never stranded), so an evolved catalog never crashes a load.
-- `faction_id` (UC14) is the FactionId slug the mission credits reputation to on completion (mining /
-- premium / board-courier) or costs it on courier expiry; NULLABLE (a faction-less mission stores NULL).
-- An unknown faction slug degrades to "no attribution" on load (dropped with a WARN). The gate
-- (unlockFaction/unlockThreshold) is NOT stored — it only affects AVAILABLE offers, which are never persisted.
CREATE TABLE mission (
    id TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL,
    source TEXT NOT NULL,
    status TEXT NOT NULL,
    reward_credits INTEGER NOT NULL,
    reward_resource TEXT,
    reward_resource_units INTEGER NOT NULL DEFAULT 0,
    quota_resource TEXT,
    quota_units INTEGER NOT NULL DEFAULT 0,
    pickup TEXT,
    destination TEXT,
    remaining_ticks INTEGER NOT NULL DEFAULT 0,
    picked_up INTEGER NOT NULL DEFAULT 0,
    faction_id TEXT
);

-- Player per-faction reputation (UC14, ADR 0013). One row per faction the player holds a NON-NEUTRAL
-- standing with; `faction_id` is the FactionId slug, `value` the clamped standing. A faction with NO row
-- is neutral (0) — only non-neutral standings are stored (like cargo storing only non-zero amounts), so a
-- fresh / migrated save reads back fully neutral. The repository coerces a stored value into the params'
-- [min,max] bounds and skips an unknown faction slug (WARN) on load. Save-wide (not per-ship), full-snapshot
-- rewrite (delete-then-insert) on each save, like the mission table.
CREATE TABLE reputation (
    faction_id TEXT NOT NULL PRIMARY KEY,
    value INTEGER NOT NULL
);

-- Read the stored save-format version (null before the meta row is seeded).
selectSaveVersion:
SELECT save_version FROM meta WHERE id = 0;

-- Seed the meta row once; idempotent (no-op if the row already exists).
initMeta:
INSERT OR IGNORE INTO meta(id, save_version) VALUES (0, ?);

-- Read the persisted handedness (null on first run / before any save).
selectSettings:
SELECT handedness FROM settings WHERE id = 0;

-- Insert-or-update the single settings row's handedness.
-- INSERT OR REPLACE (not UPSERT) so it works on minSdk-24 devices, whose bundled SQLite
-- predates the ON CONFLICT DO UPDATE syntax. Safe here: the table is single-row with no
-- foreign keys, so the delete-then-insert REPLACE performs has no side effects.
upsertHandedness:
INSERT OR REPLACE INTO settings(id, handedness) VALUES (0, ?);

-- Read the save header (UC09: header only — ships are read separately via selectAllShips so the
-- whole fleet loads, not just the active ship). Returns no rows when there is no save yet (-> New
-- Game). One row otherwise (game_state is single-slot).
selectGameState:
SELECT current_sector, active_ship_id, docked_station_id, credits, last_docked_station_id
FROM game_state
WHERE id = 0;

-- True once a save header exists (Continue available); false on a fresh / migrated-empty DB.
hasGameState:
SELECT EXISTS(SELECT 1 FROM game_state WHERE id = 0);

-- Insert-or-update the single-slot save header. INSERT OR REPLACE for the same minSdk-24 rationale
-- as upsertHandedness; single-row, no foreign keys, so REPLACE is side-effect-free.
upsertGameState:
INSERT OR REPLACE INTO game_state(id, current_sector, active_ship_id, docked_station_id, credits, last_docked_station_id) VALUES (0, ?, ?, ?, ?, ?);

-- Read every owned ship's row, ordered by id (UC09: the whole fleet; deterministic order).
selectAllShips:
SELECT id, pos_x, pos_y, vel_x, vel_y, heading, ang_vel, fuel, ship_type, crew FROM ship ORDER BY id;

-- Insert-or-update one ship row's kinematics + fuel + type + crew by id. INSERT OR REPLACE for the
-- same minSdk-24 rationale as upsertHandedness; addressed by primary key, so REPLACE is side-effect-free.
upsertShip:
INSERT OR REPLACE INTO ship(id, pos_x, pos_y, vel_x, vel_y, heading, ang_vel, fuel, ship_type, crew) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Read every ship's installed upgrades across the whole fleet, ordered deterministically (UC09).
selectAllShipUpgrades:
SELECT ship_id, slot_category, slot_index, upgrade_id FROM ship_upgrade ORDER BY ship_id, slot_category, slot_index;

-- Read one ship's installed upgrades (UC09), deterministically ordered.
selectShipUpgrades:
SELECT slot_category, slot_index, upgrade_id FROM ship_upgrade WHERE ship_id = ? ORDER BY slot_category, slot_index;

-- Clear one ship's upgrade rows. The save path does delete-then-plain-INSERT (a full snapshot
-- rewrite) rather than UPSERT/ON CONFLICT, which the bundled SQLite on minSdk-24 devices lacks.
deleteShipUpgradesForShip:
DELETE FROM ship_upgrade WHERE ship_id = ?;

-- Insert one ship-upgrade row. Always preceded by deleteShipUpgradesForShip in the same transaction,
-- so a plain INSERT (not INSERT OR REPLACE) suffices and there is never a primary-key collision.
insertShipUpgrade:
INSERT INTO ship_upgrade(ship_id, slot_category, slot_index, upgrade_id) VALUES (?, ?, ?, ?);

-- Read all cargo rows for one ship (resource name + units). Empty when the hold is empty.
selectCargo:
SELECT resource, units FROM cargo WHERE ship_id = ?;

-- Read every ship's cargo across the whole fleet, ordered deterministically (UC09).
selectAllCargo:
SELECT ship_id, resource, units FROM cargo ORDER BY ship_id, resource;

-- Clear a ship's cargo rows. The save path does delete-then-plain-INSERT (a full snapshot rewrite)
-- rather than UPSERT/ON CONFLICT, which the bundled SQLite on minSdk-24 devices does not support.
deleteCargoForShip:
DELETE FROM cargo WHERE ship_id = ?;

-- Insert one cargo row. Always preceded by deleteCargoForShip in the same transaction, so a plain
-- INSERT (not INSERT OR REPLACE) is sufficient and there is never a primary-key collision.
insertCargoEntry:
INSERT INTO cargo(ship_id, resource, units) VALUES (?, ?, ?);

-- Read every ship's combat section damage across the whole fleet, ordered deterministically (UC13).
selectAllShipSectionDamage:
SELECT ship_id, section, current_hp FROM ship_section_damage ORDER BY ship_id, section;

-- Clear one ship's section-damage rows. The save path does delete-then-plain-INSERT (a full snapshot
-- rewrite) rather than UPSERT/ON CONFLICT, which the bundled SQLite on minSdk-24 devices lacks — the
-- same rationale as cargo / ship_upgrade.
deleteShipSectionDamageForShip:
DELETE FROM ship_section_damage WHERE ship_id = ?;

-- Insert one ship section-damage row. Always preceded by deleteShipSectionDamageForShip in the same
-- transaction, so a plain INSERT (not INSERT OR REPLACE) suffices and there is never a PK collision.
insertShipSectionDamage:
INSERT INTO ship_section_damage(ship_id, section, current_hp) VALUES (?, ?, ?);

-- Read all field-depletion rows (field id + resource name + remaining units) across every field.
selectFieldDeposits:
SELECT field_id, resource, remaining_units FROM field_deposit;

-- Insert-or-update one field's remaining units for a resource. INSERT OR REPLACE (not UPSERT / ON
-- CONFLICT DO UPDATE) for the same minSdk-24 rationale as upsertHandedness/upsertGameState; the row
-- is fully specified by its (field_id, resource) primary key, so REPLACE is side-effect-free.
upsertFieldDeposit:
INSERT OR REPLACE INTO field_deposit(field_id, resource, remaining_units) VALUES (?, ?, ?);

-- Read every revealed hidden-contact id (UC10). Empty when nothing has been scanned yet.
selectRevealedContacts:
SELECT contact_id FROM revealed_contact;

-- Record one hidden contact as revealed (UC10). INSERT OR IGNORE makes it append-only and idempotent:
-- re-revealing an already-known contact is a no-op, and reveal is never undone (monotonic, AC#4). The
-- minSdk-24-safe form (no ON CONFLICT clause) matches the other write queries.
insertRevealedContact:
INSERT OR IGNORE INTO revealed_contact(contact_id) VALUES (?);

-- Read every accepted / terminal mission (UC12), ordered by id for a deterministic load order. Empty
-- when nothing has been accepted yet.
selectAllMissions:
SELECT id, type, source, status, reward_credits, reward_resource, reward_resource_units,
       quota_resource, quota_units, pickup, destination, remaining_ticks, picked_up, faction_id
FROM mission
ORDER BY id;

-- Clear every mission row. The save path does delete-then-plain-INSERT (a full snapshot rewrite of the
-- accepted/terminal missions) rather than UPSERT/ON CONFLICT, which the bundled SQLite on minSdk-24
-- devices lacks — the same rationale as the cargo / ship_upgrade snapshots.
deleteAllMissions:
DELETE FROM mission;

-- Insert one mission row. Always preceded by deleteAllMissions in the same transaction, so a plain
-- INSERT (not INSERT OR REPLACE) suffices and there is never a primary-key collision.
insertMission:
INSERT INTO mission(id, type, source, status, reward_credits, reward_resource, reward_resource_units,
                    quota_resource, quota_units, pickup, destination, remaining_ticks, picked_up, faction_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Read every persisted (non-neutral) faction standing (UC14). Empty when fully neutral.
selectReputation:
SELECT faction_id, value FROM reputation;

-- Clear every reputation row. The save path does delete-then-plain-INSERT (a full snapshot rewrite of the
-- non-neutral standings) rather than UPSERT/ON CONFLICT, which the bundled SQLite on minSdk-24 devices
-- lacks — the same rationale as the cargo / mission snapshots.
deleteAllReputation:
DELETE FROM reputation;

-- Insert one reputation row. Always preceded by deleteAllReputation in the same transaction, so a plain
-- INSERT (not INSERT OR REPLACE) suffices and there is never a primary-key collision.
insertReputation:
INSERT INTO reputation(faction_id, value) VALUES (?, ?);
