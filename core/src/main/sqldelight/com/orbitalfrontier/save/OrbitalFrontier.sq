-- Orbital Frontier save schema, version 8 (ADR 0002 / ADR 0003 / ADR 0008).
--
-- This .sq file is ALWAYS the latest schema (currently v8). Earlier versions are upgraded to it
-- by the sequential `.sqm` migration files in migrations/ (1.sqm: v1 -> v2; 2.sqm: v2 -> v3;
-- 3.sqm: v3 -> v4; 4.sqm: v4 -> v5; 5.sqm: v5 -> v6; 6.sqm: v6 -> v7; 7.sqm: v7 -> v8). Never edit
-- this baseline destructively to make a schema change — bump the version and add a migration instead.
--
-- v1 (UC01) held only `meta` (save-format version) and `settings` (handedness). v2 (UC04) adds
-- the first slice of actual game state — the single autosave "header" (`game_state`) plus the
-- player's ship kinematics (`ship`). v3 (UC05) adds the player's dock state to the header
-- (`game_state.docked_station_id`). v4 (UC06) adds the player's `cargo` (per-ship resource units)
-- and asteroid-field `field_deposit` (remaining units per field). v5 (UC07) adds the active ship's
-- `ship.fuel` level. v6 (UC08) adds the player's `game_state.credits` wallet (save-wide single
-- currency).
-- v7 (UC09) generalizes the single ship into a **fleet**: `ship` gains a `ship_type` column (the
-- ShipTypeId slug, DEFAULT 'starter' matching ShipRoster.STARTER_TYPE_ID) and there is a new
-- `ship_upgrade` table holding each ship's installed upgrades per (slot_category, slot_index). The
-- player can now own multiple ships (multiple `ship` rows, each with its own cargo + upgrades);
-- `game_state.active_ship_id` selects the active one. The v6 -> v7 migration is additive: it adds the
-- column (backfilled to 'starter') and the table (empty) so a migrated save reads back as one starter
-- ship with no upgrades. Station markets / outfit markets / upgrade & ship catalogs are NOT persisted
-- — they are fixed authored data reconstructed from MvpSectorMap / UpgradeCatalog / ShipRoster on load
-- (ADR 0007 / ADR 0008). Cargo & fuel *capacities* are derived ship stats reconstructed from
-- type + loadout on load (ShipStats), never stored. Box2D internals are never persisted — only the
-- pure kinematics the model re-seeds the body from on load (UC04 pitfall).
-- v8 (UC10) adds the new `revealed_contact` table: the ids of no-transponder hidden contacts the
-- player has uncovered by active scanning (UC10 AC#4). Reveal is **monotonic** — a row is only ever
-- inserted (INSERT OR IGNORE), never deleted, so a revealed contact stays known across save/reload.
-- The v7 -> v8 migration is additive: it creates the (empty) table, so a migrated save reads back with
-- nothing revealed. Hidden contacts themselves are fixed authored map data (MvpSectorMap), not stored.
--
-- The `meta`/`settings` rows are single-row (CHECK (id = 0)); `game_state` is likewise single-row.

CREATE TABLE meta (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    save_version INTEGER NOT NULL
);

CREATE TABLE settings (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    handedness TEXT NOT NULL
);

-- Single-row save "header": which sector the player is in, which owned ship is active, which
-- station (if any) the active ship is docked at, and the player's credit balance. Future save-wide
-- singletons (current mission, …) land here additively as later UCs arrive.
-- `docked_station_id` is NULLABLE: NULL means the active ship is in flight (the common case); a
-- non-null value is the [PoiId] of the docked station (UC05 AC#4).
-- `credits` (UC08) is the player's single-currency wallet, save-wide (not per-ship). DEFAULT 0
-- matches the v5 -> v6 migration's backfill; the repository coerces a negative/corrupt value to >= 0.
CREATE TABLE game_state (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    current_sector TEXT NOT NULL,
    active_ship_id INTEGER NOT NULL,
    docked_station_id TEXT,
    credits INTEGER NOT NULL DEFAULT 0
);

-- Owned-ship kinematics + per-ship stats source (UC09: one row per owned ship; `active_ship_id`
-- selects the active one). Stored as REAL (SQLite has no Float); the repository owns the single
-- Float<->Double conversion so a round-trip is exact (UC04 AC#8).
-- `fuel` (UC07) is the ship's fuel level in fuel units; capacity is NOT stored — it is a derived
-- ship stat (ShipStats.fuelCapacity(type, loadout)) reconstructed on load.
-- `ship_type` (UC09) is the ShipTypeId slug (ShipRoster). DEFAULT 'starter' matches the v6 -> v7
-- migration's backfill so a migrated ship reads back as the starter type. An unknown slug degrades
-- to the starter type with a WARN on load (never stranded).
CREATE TABLE ship (
    id INTEGER NOT NULL PRIMARY KEY,
    pos_x REAL NOT NULL,
    pos_y REAL NOT NULL,
    vel_x REAL NOT NULL,
    vel_y REAL NOT NULL,
    heading REAL NOT NULL,
    ang_vel REAL NOT NULL,
    fuel REAL NOT NULL DEFAULT 100,
    ship_type TEXT NOT NULL DEFAULT 'starter'
);

-- Per-ship installed upgrades (UC09). One row per filled (ship, slot): `slot_category` is the
-- SlotCategory enum *name*, `slot_index` the slot position within that category (gaps are allowed —
-- an absent (category, index) is an empty slot), `upgrade_id` the UpgradeId slug (resolved against
-- UpgradeCatalog on load; an unknown id is skipped with a WARN). Keyed by (ship_id, slot_category,
-- slot_index). A ship's rows are rewritten as a full snapshot (delete-then-insert) on each save.
CREATE TABLE ship_upgrade (
    ship_id INTEGER NOT NULL,
    slot_category TEXT NOT NULL,
    slot_index INTEGER NOT NULL,
    upgrade_id TEXT NOT NULL,
    PRIMARY KEY (ship_id, slot_category, slot_index)
);

-- Per-ship cargo (UC06). One row per (ship, resource) the ship is carrying a non-zero amount of;
-- `resource` is the ResourceType enum *name* (stable across enum reordering, unlike its ordinal).
-- Keyed by (ship_id, resource). Capacity is NOT stored — it is a derived ship stat reconstructed from
-- type + loadout on load. Each ship's rows are rewritten as a full snapshot (delete-then-insert).
CREATE TABLE cargo (
    ship_id INTEGER NOT NULL,
    resource TEXT NOT NULL,
    units INTEGER NOT NULL,
    PRIMARY KEY (ship_id, resource)
);

-- Asteroid-field depletion (UC06). One row per (field, resource) the field has been mined from,
-- storing the *remaining* units. `field_id` is the field's PoiId value (globally unique across the
-- sector graph — see SectorWorld.allPoiIds), `resource` the ResourceType enum name. A field with NO
-- rows here is pristine (its authored deposits apply). Depletion is monotonic (units only ever
-- decrease), so saves upsert the latest snapshot per (field, resource) and never delete.
CREATE TABLE field_deposit (
    field_id TEXT NOT NULL,
    resource TEXT NOT NULL,
    remaining_units INTEGER NOT NULL,
    PRIMARY KEY (field_id, resource)
);

-- Revealed hidden contacts (UC10). One row per [HiddenContact] the player has uncovered by active
-- scanning; `contact_id` is the contact's PoiId value (globally unique across the sector graph). A
-- contact with NO row here is still hidden. Reveal is monotonic (a contact never re-hides), so saves
-- only ever INSERT OR IGNORE these ids and never delete. A row for a contact the authored map no
-- longer contains is harmless (it resolves to nothing on load).
CREATE TABLE revealed_contact (
    contact_id TEXT NOT NULL PRIMARY KEY
);

-- Read the stored save-format version (null before the meta row is seeded).
selectSaveVersion:
SELECT save_version FROM meta WHERE id = 0;

-- Seed the meta row once; idempotent (no-op if the row already exists).
initMeta:
INSERT OR IGNORE INTO meta(id, save_version) VALUES (0, ?);

-- Read the persisted handedness (null on first run / before any save).
selectSettings:
SELECT handedness FROM settings WHERE id = 0;

-- Insert-or-update the single settings row's handedness.
-- INSERT OR REPLACE (not UPSERT) so it works on minSdk-24 devices, whose bundled SQLite
-- predates the ON CONFLICT DO UPDATE syntax. Safe here: the table is single-row with no
-- foreign keys, so the delete-then-insert REPLACE performs has no side effects.
upsertHandedness:
INSERT OR REPLACE INTO settings(id, handedness) VALUES (0, ?);

-- Read the save header (UC09: header only — ships are read separately via selectAllShips so the
-- whole fleet loads, not just the active ship). Returns no rows when there is no save yet (-> New
-- Game). One row otherwise (game_state is single-slot).
selectGameState:
SELECT current_sector, active_ship_id, docked_station_id, credits
FROM game_state
WHERE id = 0;

-- True once a save header exists (Continue available); false on a fresh / migrated-empty DB.
hasGameState:
SELECT EXISTS(SELECT 1 FROM game_state WHERE id = 0);

-- Insert-or-update the single-slot save header. INSERT OR REPLACE for the same minSdk-24 rationale
-- as upsertHandedness; single-row, no foreign keys, so REPLACE is side-effect-free.
upsertGameState:
INSERT OR REPLACE INTO game_state(id, current_sector, active_ship_id, docked_station_id, credits) VALUES (0, ?, ?, ?, ?);

-- Read every owned ship's row, ordered by id (UC09: the whole fleet; deterministic order).
selectAllShips:
SELECT id, pos_x, pos_y, vel_x, vel_y, heading, ang_vel, fuel, ship_type FROM ship ORDER BY id;

-- Insert-or-update one ship row's kinematics + fuel + type by id. INSERT OR REPLACE for the same
-- minSdk-24 rationale as upsertHandedness; addressed by primary key, so REPLACE is side-effect-free.
upsertShip:
INSERT OR REPLACE INTO ship(id, pos_x, pos_y, vel_x, vel_y, heading, ang_vel, fuel, ship_type) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Read every ship's installed upgrades across the whole fleet, ordered deterministically (UC09).
selectAllShipUpgrades:
SELECT ship_id, slot_category, slot_index, upgrade_id FROM ship_upgrade ORDER BY ship_id, slot_category, slot_index;

-- Read one ship's installed upgrades (UC09), deterministically ordered.
selectShipUpgrades:
SELECT slot_category, slot_index, upgrade_id FROM ship_upgrade WHERE ship_id = ? ORDER BY slot_category, slot_index;

-- Clear one ship's upgrade rows. The save path does delete-then-plain-INSERT (a full snapshot
-- rewrite) rather than UPSERT/ON CONFLICT, which the bundled SQLite on minSdk-24 devices lacks.
deleteShipUpgradesForShip:
DELETE FROM ship_upgrade WHERE ship_id = ?;

-- Insert one ship-upgrade row. Always preceded by deleteShipUpgradesForShip in the same transaction,
-- so a plain INSERT (not INSERT OR REPLACE) suffices and there is never a primary-key collision.
insertShipUpgrade:
INSERT INTO ship_upgrade(ship_id, slot_category, slot_index, upgrade_id) VALUES (?, ?, ?, ?);

-- Read all cargo rows for one ship (resource name + units). Empty when the hold is empty.
selectCargo:
SELECT resource, units FROM cargo WHERE ship_id = ?;

-- Read every ship's cargo across the whole fleet, ordered deterministically (UC09).
selectAllCargo:
SELECT ship_id, resource, units FROM cargo ORDER BY ship_id, resource;

-- Clear a ship's cargo rows. The save path does delete-then-plain-INSERT (a full snapshot rewrite)
-- rather than UPSERT/ON CONFLICT, which the bundled SQLite on minSdk-24 devices does not support.
deleteCargoForShip:
DELETE FROM cargo WHERE ship_id = ?;

-- Insert one cargo row. Always preceded by deleteCargoForShip in the same transaction, so a plain
-- INSERT (not INSERT OR REPLACE) is sufficient and there is never a primary-key collision.
insertCargoEntry:
INSERT INTO cargo(ship_id, resource, units) VALUES (?, ?, ?);

-- Read all field-depletion rows (field id + resource name + remaining units) across every field.
selectFieldDeposits:
SELECT field_id, resource, remaining_units FROM field_deposit;

-- Insert-or-update one field's remaining units for a resource. INSERT OR REPLACE (not UPSERT / ON
-- CONFLICT DO UPDATE) for the same minSdk-24 rationale as upsertHandedness/upsertGameState; the row
-- is fully specified by its (field_id, resource) primary key, so REPLACE is side-effect-free.
upsertFieldDeposit:
INSERT OR REPLACE INTO field_deposit(field_id, resource, remaining_units) VALUES (?, ?, ?);

-- Read every revealed hidden-contact id (UC10). Empty when nothing has been scanned yet.
selectRevealedContacts:
SELECT contact_id FROM revealed_contact;

-- Record one hidden contact as revealed (UC10). INSERT OR IGNORE makes it append-only and idempotent:
-- re-revealing an already-known contact is a no-op, and reveal is never undone (monotonic, AC#4). The
-- minSdk-24-safe form (no ON CONFLICT clause) matches the other write queries.
insertRevealedContact:
INSERT OR IGNORE INTO revealed_contact(contact_id) VALUES (?);
