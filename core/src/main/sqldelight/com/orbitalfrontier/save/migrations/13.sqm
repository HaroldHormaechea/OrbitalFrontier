-- Migration v13 -> v14 (named by FROM-version, per ADR 0002's sequential .sqm chain).
--
-- v13 (UC15) held meta + settings + the save header (game_state) + per-ship rows + cargo + ship_upgrade
-- + ship_section_damage + field_deposit + revealed_contact + mission + reputation + owned_station +
-- station_module. v14 (UC31, ADR 0020) adds the **audio preferences** to the single-row `settings`
-- table:
--
--  1. `settings.master_muted` — a new INTEGER column (0/1) for the master mute, DEFAULT 0 (unmuted).
--  2. `settings.sfx_volume`  — a new REAL column for the SFX gain, DEFAULT 1.0 (full).
--  3. `settings.music_volume`— a new REAL column for the music gain, DEFAULT 0.5 (half, so music sits
--     under the effects).
--
-- A pre-UC31 save had no audio preferences, so a migrated `settings` row reads back at these defaults
-- (audio enabled at default levels) — the new columns' DEFAULTs backfill the existing single row, and
-- the handedness value is untouched. ALTER TABLE ADD COLUMN is supported by the bundled SQLite on
-- minSdk-24 devices (it long predates 24), so this is minSdk-safe — the same rationale as every prior
-- additive migration. All prior data is untouched.

ALTER TABLE settings ADD COLUMN master_muted INTEGER NOT NULL DEFAULT 0;
ALTER TABLE settings ADD COLUMN sfx_volume REAL NOT NULL DEFAULT 1.0;
ALTER TABLE settings ADD COLUMN music_volume REAL NOT NULL DEFAULT 0.5;

UPDATE meta SET save_version = 14 WHERE id = 0;
