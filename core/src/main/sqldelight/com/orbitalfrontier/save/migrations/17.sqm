-- Migration v17 -> v18 (named by FROM-version, per ADR 0002's sequential .sqm chain).
--
-- v17 (UC38, ADR 0026) partitioned every game-state table by `slot_id` and added the per-slot display
-- metadata + the active-slot pointer; `settings` was unchanged. v18 (UC39) adds the **accessibility
-- preferences** to the single-row `settings` table — three new global control prefs that live beside
-- handedness / audio / tutorial / joystick / ui_scale, each its own column with its own targeted UPDATE
-- so persisting one never clobbers another:
--
--  1. `settings.colorblind_mode` — a new TEXT column for the colour-vision palette mode
--     ([com.orbitalfrontier.settings.ColorVisionMode] NAME), DEFAULT 'STANDARD' (the prior implicit
--     palette). An unknown stored value degrades to STANDARD on load (like handedness).
--  2. `settings.text_scale`      — a new REAL column for the UI text-size multiplier applied on top of
--     the global UI scale, DEFAULT 1.0 (no extra magnification — the prior behaviour).
--  3. `settings.reduced_motion`  — a new INTEGER (0/1) column for the reduced-motion toggle,
--     DEFAULT 0 (motion on — the prior behaviour: full parallax starfield).
--
-- A pre-UC39 save had none of these preferences, so a migrated `settings` row reads them back at these
-- defaults — byte-for-byte the behaviour the player already had (standard palette, ×1 text, motion on).
-- The new columns' DEFAULTs backfill the existing single row; every other column is untouched. ALTER
-- TABLE ADD COLUMN is supported by the bundled SQLite on minSdk-24 devices (it long predates 24), so
-- this is minSdk-safe — the same rationale as every prior additive migration. All prior data is
-- untouched, and no game-state table is rebuilt (`settings` is global, unchanged by v17's partitioning).

ALTER TABLE settings ADD COLUMN colorblind_mode TEXT NOT NULL DEFAULT 'STANDARD';
ALTER TABLE settings ADD COLUMN text_scale REAL NOT NULL DEFAULT 1.0;
ALTER TABLE settings ADD COLUMN reduced_motion INTEGER NOT NULL DEFAULT 0;

UPDATE meta SET save_version = 18 WHERE id = 0;
