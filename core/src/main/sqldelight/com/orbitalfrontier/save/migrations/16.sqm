-- mission: add slot_id to the PK.
CREATE TABLE mission_new (
    slot_id INTEGER NOT NULL,
    id TEXT NOT NULL,
    type TEXT NOT NULL,
    source TEXT NOT NULL,
    status TEXT NOT NULL,
    reward_credits INTEGER NOT NULL,
    reward_resource TEXT,
    reward_resource_units INTEGER NOT NULL DEFAULT 0,
    quota_resource TEXT,
    quota_units INTEGER NOT NULL DEFAULT 0,
    pickup TEXT,
    destination TEXT,
    remaining_ticks INTEGER NOT NULL DEFAULT 0,
    picked_up INTEGER NOT NULL DEFAULT 0,
    faction_id TEXT,
    PRIMARY KEY (slot_id, id)
);
INSERT INTO mission_new (slot_id, id, type, source, status, reward_credits, reward_resource,
                         reward_resource_units, quota_resource, quota_units, pickup, destination,
                         remaining_ticks, picked_up, faction_id)
SELECT 0, id, type, source, status, reward_credits, reward_resource, reward_resource_units,
       quota_resource, quota_units, pickup, destination, remaining_ticks, picked_up, faction_id
FROM mission;
DROP TABLE mission;
ALTER TABLE mission_new RENAME TO mission;

