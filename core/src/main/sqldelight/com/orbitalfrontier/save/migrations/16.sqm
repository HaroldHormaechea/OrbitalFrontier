-- Migration v16 -> v17 (named by FROM-version, per ADR 0002's sequential .sqm chain).
--
-- v16 (UC37) held a SINGLE autosave: `game_state` was single-row (CHECK (id = 0)) and every game-state
-- table belonged implicitly to that one save. v17 (UC38, ADR 0026) adds **save-slot management** by
-- partitioning every game-state table by a new `slot_id` column added to its primary key, and adds the
-- per-slot display metadata + the active-slot pointer.
--
-- This is the FIRST table-rebuild migration in this codebase — all 15 prior `.sqm` files were additive
-- (ADD COLUMN / CREATE TABLE only). Adding a column to an existing primary key cannot be done with
-- ALTER TABLE, so each of the 11 game-state tables is rebuilt with the SQLite table-rebuild recipe:
--   CREATE the v17-shape table -> INSERT … SELECT … (backfilling slot_id = 0 = the LEGACY slot) ->
--   DROP the old table -> ALTER … RENAME the new one into place.
-- The pre-UC38 single autosave is backfilled into slot 0 (UC38 AC#3), so an upgraded save reads back
-- intact as the legacy slot, named "Autosave". Column order/type/affinity/constraints are written to
-- match OrbitalFrontier.sq EXACTLY so the regenerated databases/17.db schema matches the .sq (the
-- SQLDelight verifyMigrations gate). There are no foreign keys or explicit indices in this schema, so
-- only the primary keys (recreated by the CREATE statements) need rebuilding; foreign_keys=OFF is set
-- discipline. There are no foreign keys or explicit indices in this schema, so no PRAGMA toggling is
-- needed (and the SQLDelight dialect rejects `PRAGMA foreign_keys=ON` at author time anyway).
--
-- `settings` is UNCHANGED (control/audio/UI preferences are global, not per-slot).

-- meta: plain additive ADD COLUMN — the active-slot pointer. The single existing row keeps the DEFAULT 0,
-- so the legacy save's autosave/Continue points at slot 0.
ALTER TABLE meta ADD COLUMN active_slot_id INTEGER NOT NULL DEFAULT 0;

-- game_state: drop the single-row CHECK (id = 0); repartition by `slot_id` (new PK); add the slot display
-- metadata (name / last-saved / play-time). The legacy single row becomes slot 0 named "Autosave"
-- (last-saved + play-time backfilled to 0 — unknown for a pre-UC38 save).
CREATE TABLE game_state_new (
    slot_id INTEGER NOT NULL PRIMARY KEY,
    current_sector TEXT NOT NULL,
    active_ship_id INTEGER NOT NULL,
    docked_station_id TEXT,
    credits INTEGER NOT NULL DEFAULT 0,
    last_docked_station_id TEXT,
    name TEXT NOT NULL DEFAULT '',
    last_saved_epoch_millis INTEGER NOT NULL DEFAULT 0,
    play_time_seconds INTEGER NOT NULL DEFAULT 0
);
INSERT INTO game_state_new (slot_id, current_sector, active_ship_id, docked_station_id, credits,
                            last_docked_station_id, name, last_saved_epoch_millis, play_time_seconds)
SELECT 0, current_sector, active_ship_id, docked_station_id, credits, last_docked_station_id,
       'Autosave', 0, 0
FROM game_state;
DROP TABLE game_state;
ALTER TABLE game_state_new RENAME TO game_state;

-- ship: add slot_id to the PK (ship ids are per-save, so they collide across slots — composite PK).
CREATE TABLE ship_new (
    slot_id INTEGER NOT NULL,
    id INTEGER NOT NULL,
    pos_x REAL NOT NULL,
    pos_y REAL NOT NULL,
    vel_x REAL NOT NULL,
    vel_y REAL NOT NULL,
    heading REAL NOT NULL,
    ang_vel REAL NOT NULL,
    fuel REAL NOT NULL DEFAULT 100,
    ship_type TEXT NOT NULL DEFAULT 'starter',
    crew INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (slot_id, id)
);
INSERT INTO ship_new (slot_id, id, pos_x, pos_y, vel_x, vel_y, heading, ang_vel, fuel, ship_type, crew)
SELECT 0, id, pos_x, pos_y, vel_x, vel_y, heading, ang_vel, fuel, ship_type, crew FROM ship;
DROP TABLE ship;
ALTER TABLE ship_new RENAME TO ship;

-- ship_upgrade: add slot_id to the PK.
CREATE TABLE ship_upgrade_new (
    slot_id INTEGER NOT NULL,
    ship_id INTEGER NOT NULL,
    slot_category TEXT NOT NULL,
    slot_index INTEGER NOT NULL,
    upgrade_id TEXT NOT NULL,
    PRIMARY KEY (slot_id, ship_id, slot_category, slot_index)
);
INSERT INTO ship_upgrade_new (slot_id, ship_id, slot_category, slot_index, upgrade_id)
SELECT 0, ship_id, slot_category, slot_index, upgrade_id FROM ship_upgrade;
DROP TABLE ship_upgrade;
ALTER TABLE ship_upgrade_new RENAME TO ship_upgrade;

